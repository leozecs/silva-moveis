# Copie para /opt/silva-moveis/.env.production na VPS e chmod 600.
# Nunca commite o arquivo real.
NODE_ENV=production
POSTGRES_DB=medusa_backend
POSTGRES_USER=medusa_app
POSTGRES_PASSWORD=gere-uma-senha-forte
DATABASE_URL=postgres://medusa_app:gere-uma-senha-forte@postgres:5432/medusa_backend
REDIS_PASSWORD=gere-outra-senha-forte
REDIS_URL=redis://:gere-outra-senha-forte@redis:6379
JWT_SECRET=gere-um-segredo-aleatorio
COOKIE_SECRET=gere-outro-segredo-aleatorio
MEDUSA_DB_MIGRATION_CONNECTION_TIMEOUT=60000
MEDUSA_HOST_PORT=9000
STORE_CORS=https://silvamoveis.com.br,https://www.silvamoveis.com.br
ADMIN_CORS=https://admin.silvamoveis.com.br
AUTH_CORS=https://silvamoveis.com.br,https://www.silvamoveis.com.br
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://srv1969702.hstgr.cloud
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
NEXT_PUBLIC_MEDUSA_REGION_ID=reg_replace_me
WEB_HOST_PORT=3000
